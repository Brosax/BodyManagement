# 复制为 .env.local 并填写真实值（.env.local 不入库）

# Neon / Vercel Postgres 连接串
DATABASE_URL=

# OpenAI 兼容 AI（默认 DeepSeek；也可换成 OpenRouter）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 保护 cron 端点的随机字符串
CRON_SECRET=
